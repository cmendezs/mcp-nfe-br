<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.sped.fazenda.gov.br/nfsevia"
           xmlns="http://www.sped.fazenda.gov.br/nfsevia"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified">

	<xs:simpleType name="TSVerNFSeVia">
		<xs:annotation>
			<xs:documentation>Versão da NFS-e Via - 1.00</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="1\.00"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSIdNFSeVia">
		<xs:annotation>
			<xs:documentation>
				Informar o identificador precedido do literal ‘VIA’. A regra de formação do identificador do VIA é:
				"VIA" + Cód.da localidade/trecho (7) + Amb.Ger. (1) + Inscrição Federal (14) + nNFS-e Via (13) + serie (3) + AnoMes Emis. da NFS-e Via (4) + Cód.Num. (7) + DV (1)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:length value="53"/>
			<xs:pattern value="VIA[0-9]{8}[0-9A-Z]{12}[0-9]{15}[0-9A-Z]{3}[0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSTipoAmbiente">
		<xs:annotation>
			<xs:documentation>
				Tipos de ambiente do Sistema Nacional NFS-e Via: 1 - Produção; 2 - Homologação;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSCodMunIBGE">
		<xs:annotation>
			<xs:documentation>Tipo Código do Município segundo tabela IBGE</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[0-9]{7}"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSString">
		<xs:annotation>
			<xs:documentation>Tipo string genérico</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[!-ÿ]{1}[ -ÿ]{0,}[!-ÿ]{1}|[!-ÿ]{1}"/>
		</xs:restriction>
	</xs:simpleType>
	

	<xs:simpleType name="TSDesc150">
		<xs:restriction base="TSString">
			<xs:minLength value="1"/>
			<xs:maxLength value="150"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSDesc600">
		<xs:restriction base="TSStringComQuebraDeLinha">
			<xs:minLength value="1"/>
			<xs:maxLength value="600"/>
		</xs:restriction>
	</xs:simpleType>



	<xs:simpleType name="TSNumNFSeVia">
		<xs:annotation>
			<xs:documentation>Número sequencial, por praça e por equipamento, de pedágio, da NFS-e VIA gerado pelo emitente e tipo de emitente da NFS-e VIA.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:length value="13"/>
			<xs:pattern value="[0-9]{13}"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSSerie">
		<xs:annotation>
			<xs:documentation>Tipo Série para cada praça ou equipamento NFS-e Via</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="3"/>
			<xs:whiteSpace value="preserve"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSVersaoEmissor">
		<xs:annotation>
			<xs:documentation>Tipo Versão da aplicação emissora NFS-e Via</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="20"/>
			<xs:minLength value="1"/>
			<xs:whiteSpace value="preserve"/>
		</xs:restriction>
	</xs:simpleType>	

	<xs:simpleType name="TStat">
		<xs:annotation>
			<xs:documentation>
				100 - NFS-e Via;
				101 - NFS-e Via de Substituição;
				102 - NFS-e Via de Decisão Judicial;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="100"/>
			<xs:enumeration value="101"/>
			<xs:enumeration value="102"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSData">
		<xs:annotation>
			<xs:documentation> Tipo data no formato AAAA-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TSDateTimeUTC">
		<xs:annotation>
			<xs:documentation>Data e Hora, formato UTC (AAAA-MM-DDThh:mm:ssTZD, onde TZD = +hh:mm ou -hh:mm)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d([\-,\+](0[0-9]|10|11):00|([\+](12):00))"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSMotivoSubstituicao">
		<xs:annotation>
			<xs:documentation>
				Código de justificativa para substituição de NFS-e Via:
				03 - Inclusão Retroativa de Imunidade/Isenção para NFS-e Via;
				04 - Exclusão Retroativa de Imunidade/Isenção para NFS-e Vias;
				06 - Alteração de parâmetros de cadastro do trecho da concessão;
				07 - Erro na identificação do veículo;
				99 - Outros;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="03"/>
			<xs:enumeration value="04"/>
			<xs:enumeration value="06"/>
			<xs:enumeration value="07"/>
			<xs:enumeration value="99"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSDescricaoMotivoSubstituicao">
		<xs:annotation>
			<xs:documentation>
				Descrição do motivo da substituição da NFS-e Via. Deve ser informada quando o motivo for 99 - Outros.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="TSString">
			<xs:minLength value="15"/>
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSCNPJ">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:maxLength value="14"/>
			<xs:pattern value="[0-9A-Z]{12}[0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSCPF">
		<xs:annotation>
			<xs:documentation>Tipo Número do CPF</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:maxLength value="11"/>
			<xs:pattern value="[0-9]{11}"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSNBS">
		<xs:annotation>
			<xs:documentation>
				Código NBS correspondente ao serviço prestado: 106042100 (fixo)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="106042100"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSCodTribNac">
		<xs:annotation>
			<xs:documentation>
				Código de tributação nacional do ISSQN: 220101 (fixo)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="220101"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSCategoriaVeiculo">
		<xs:annotation>
			<xs:documentation>
				Categorias de veículos para cobrança:

				00 - Categoria de Veículos (tipo não informado na nota de origem);
				01 - Automóvel, caminhonete e furgão - (2 eixos);
				02 - Caminhão leve, ônibus, caminhão trator e furgão - (2 eixos);
				03 - Automóvel e caminhonete com semireboque - (3 eixos);
				04 - Caminhão, caminhão-trator, caminhão-trator com semi-reboque e ônibus - (3 eixos);
				05 - Automóvel e caminhonete com reboque - (4 eixos);
				06 - Caminhão com reboque e caminhãotrator com semi-reboque - (4 eixos);
				07 - Caminhão com reboque e caminhãotrator com semi-reboque - (5 eixos);
				08 - Caminhão com reboque e caminhãotrator com semi-reboque - (6 eixos);
				09 - Caminhão com reboque e caminhãotrator com semi-reboque - (7 eixos);
				10 - Caminhão com reboque e caminhãotrator com semi-reboque - (8 eixos);
				11 - Motocicletas, motonetas e bicicletas motorizadas;
				12 - Veículo com gratuidade;
				99 - Cobrança Especial
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="00"/>
			<xs:enumeration value="01"/>
			<xs:enumeration value="02"/>
			<xs:enumeration value="03"/>
			<xs:enumeration value="04"/>
			<xs:enumeration value="05"/>
			<xs:enumeration value="06"/>
			<xs:enumeration value="07"/>
			<xs:enumeration value="08"/>
			<xs:enumeration value="09"/>
			<xs:enumeration value="10"/>
			<xs:enumeration value="11"/>
			<xs:enumeration value="12"/>
			<xs:enumeration value="99"/>
		</xs:restriction>
	</xs:simpleType>

	
	<xs:simpleType name="TSRodagem">
		<xs:annotation>
			<xs:documentation>
				Tipo de rodagem:
				1 - Simples;
				2 - Dupla;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TSSentido">
		<xs:annotation>
			<xs:documentation>Orientação de passagem do veículo: ângulo em graus a partir do norte geográfico em sentido horário, número inteiro de 0 a 359, onde 0º seria o norte, 90º o leste, 180º o sul, 270º o oeste. Precisão mínima de 10</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[0-9]|[1-9][0-9]|[12][0-9][0-9]|3[0-5][0-9]"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSPlaca">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:minLength value="1"/>
			<xs:maxLength value="10"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSCodAcessoPedagio">
		<xs:annotation>
			<xs:documentation>
				Código de acesso gerado automaticamente pelo sistema emissor da concessionária.
				Identifica unicamente a NFS-e Via pelo adquirente (tomador) de serviço que informará este código na consulta pública realizada no Sistema Nacional NFS-e Via, o que possibilitará incluir seu CPF/CNPJ na manifestação para identificação do adquirente.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[0-9A-Z]{17}"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSModPassagem">
		<xs:annotation>
			<xs:documentation>
				Modalidade Passagem
				1 - Fluxo Livre;
				2 - Manual;
				3 - Automático;
				4 - Semi-Automático;
				5 - Outros
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSModPagamento">
		<xs:annotation>
			<xs:documentation>
				Modalidade de pagamento:
				1 - Débito
				2 - Crédito
				3 - Dinheiro
				4 - Eletrônico
				5 - Pagamento posterior
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
			<xs:enumeration value="5"/>
		</xs:restriction>
	</xs:simpleType>

	

	<xs:simpleType name="TSCodContrato">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[a-zA-Z0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSStringComQuebraDeLinha">
		<xs:annotation>
			<xs:documentation>Tipo string genérico</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[\s\S!-ÿ]{1}[\s\S -ÿ]{0,}[\s\S!-ÿ]{1}|[\s\S!-ÿ]{1}"/>
		</xs:restriction>
	</xs:simpleType>



	<xs:simpleType name="TSDesc2000">
		<xs:restriction base="TSStringComQuebraDeLinha">
			<xs:minLength value="1"/>
			<xs:maxLength value="2000"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSDec7V3">
		<xs:annotation>
			<xs:documentation>Valor decimal com 1 a 7 dígitos mais 3 casas decimais</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2}|[1-9]{1}[0-9]{0,6}(\.[0-9]{3})?"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSDec7V6">
		<xs:annotation>
			<xs:documentation>Valor decimal com 1 a 7 dígitos mais 3 casas decimais</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2}|[1-9]{1}[0-9]{0,6}(\.[0-9]{6})?"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="TSDec2V2">
		<xs:annotation>
			<xs:documentation>Valor decimal com 1 ou 2 dígitos mais 2 casas decimais</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2}|[1-9]{1}[0-9]{0,1}(\.[0-9]{2})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TSDec3V2">
		<xs:annotation>
			<xs:documentation>Valor decimal com 1 a 3 dígitos mais 2 casas decimais</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2}|[1-9]{1}[0-9]{0,2}(\.[0-9]{2})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TSDec15V2">
		<xs:annotation>
			<xs:documentation>Valor decimal com 1 a 15 dígitos mais 2 casas decimais</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2}|[1-9]{1}[0-9]{0,14}(\.[0-9]{2})?"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSTribISSQN">
		<xs:annotation>
			<xs:documentation>
				Tributação do ISSQN sobre o serviço prestado:
				1 - Operação tributável;			
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSOpExigSuspensa">
		<xs:annotation>
			<xs:documentation>
				Opção para Exigibilidade Suspensa:
				1 - Exigibilidade do ISSQN Suspensa por Decisão Judicial;
				2 - Exigibilidade do ISSQN Suspensa por Processo Administrativo;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSNumProcExigSuspensa">
		<xs:annotation>
			<xs:documentation>Número do processo judicial ou administrativo de suspensão da exigibilidade</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{30}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSTipoCST">
		<xs:annotation>
			<xs:documentation>
				Código de Situação Tributária do PIS/COFINS (CST):
				00 - Nenhum;
				01 - Operação Tributável com Alíquota Básica;
				02 - Operação Tributável com Alíquota Diferenciada;			
				06 - Operação Tributável a Alíquota Zero;
				07 - Operação Tributável da Contribuição;
				08 - Operação sem Incidência da Contribuição;
				09 - Operação com Suspensão da Contribuição;
				49 - Passagem sem cobrança
				98 - Anulação
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="00"/>
			<xs:enumeration value="01"/>
			<xs:enumeration value="02"/>			
			<xs:enumeration value="06"/>
			<xs:enumeration value="07"/>
			<xs:enumeration value="08"/>
			<xs:enumeration value="09"/>
			<xs:enumeration value="49"/>
			<xs:enumeration value="98"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSTipoRetPISCofins">
		<xs:annotation>
			<xs:documentation>
				Tipo de retenção ao do PIS/COFINS:
				1 - PIS/COFINS Retido;
				2 - PIS/COFINS Não Retido;
				3 - PIS Retido/COFINS Não Retido;
				4 - PIS Não Retido/COFINS Retido;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
			<xs:enumeration value="3"/>
			<xs:enumeration value="4"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSNIF">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:minLength value="1"/>
			<xs:maxLength value="40"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSCodNaoNIF">
		<xs:annotation>
			<xs:documentation>
				Motivo para não informação do NIF:
				0 - Não informado na nota de origem;
				1 - Dispensado do NIF;
				2 - Não exigência do NIF;
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="0"/>
			<xs:enumeration value="1"/>
			<xs:enumeration value="2"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSCodCST">
		<xs:annotation>
			<xs:documentation>
				Código de Situação Tributária do IBS: 000
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="000"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSCodClassTrib">
		<xs:annotation>
			<xs:documentation>
				Código de classificação Tributária do IBS: 000002
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="000002"/>
		</xs:restriction>
	</xs:simpleType>

	
	<xs:simpleType name="TSIndOperacao">
		<xs:annotation>
			<xs:documentation>
				Código da classificação do indicador da operação: 080101
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="080101"/>
		</xs:restriction>
	</xs:simpleType>	


	<!-- Tipos especializados para campos com annotation -->

	<!-- Para cLocEmi -->
	<xs:simpleType name="TSLocEmiCodMunIBGE">
		<xs:restriction base="TSCodMunIBGE">
			<xs:annotation>
				<xs:documentation>
					Código de 7 dígitos do município (IBGE) onde está localizada a praça de pedágio.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para cPracaEmi -->
	<xs:simpleType name="TSPracaEmiCodigo">
		<xs:restriction base="TSCodMunIBGE">
			<xs:annotation>
				<xs:documentation>
					Código de 7 dígitos da praça de pedágio.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para xPracaEmi -->
	<xs:simpleType name="TSPracaEmiDesc150">
		<xs:restriction base="TSDesc150">
			<xs:annotation>
				<xs:documentation>
					Descrição do código da praça de pedágio utilizado pelo Sistema Nacional NFS-e Via é o nome de cada praça de pedágio.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para xLocEmi -->
	<xs:simpleType name="TSLocEmiDesc150">
		<xs:restriction base="TSDesc150">
			<xs:annotation>
				<xs:documentation>
					Descrição do código de 7 dígitos do município (IBGE) onde está localizada a praça de pedágio.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para dhEmi -->
	<xs:simpleType name="TSEmissaoDateTimeUTC">
		<xs:restriction base="TSDateTimeUTC">
			<xs:annotation>
				<xs:documentation>
					Data e hora da emissão da NFS-e Via.
					Data e hora no formato UTC (Universal Coordinated Time):
					AAAA-MM-DDThh:mm:ssTZD
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para dhEmi -->
	<xs:simpleType name="TSCompetenciaDateTimeUTC">
		<xs:restriction base="TSDateTimeUTC">
			<xs:annotation>
				<xs:documentation>
					Data e Hora da competência da prestação do serviço: passagem veicular
					Data e hora no formato UTC (Universal Coordinated Time):
					AAAA-MM-DDThh:mm:ssTZD
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSKmPracaEmi">
		<xs:restriction base="TSDec7V6">
			<xs:annotation>
				<xs:documentation>
					Quilometragem da praça de pedágio.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>
	
	<!-- Para vServ -->
	<xs:simpleType name="TSServDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor total dos serviços prestados, sem deduções, em moeda corrente nacional.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vBC -->
	<xs:simpleType name="TSBCDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor da Base de Cálculo do ISSQN (R$) = Valor do Serviço - Desconto Incondicionado - Deduções/Reduções - Benefício Municipal
					vBC = vServ - descIncond
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para pAliq -->
	<xs:simpleType name="TSAliqDesc2V2">
		<xs:restriction base="TSDec2V2">
			<xs:annotation>
				<xs:documentation>
					Valor da alíquota efetiva (%) do serviço prestado resultante do cadastro do trecho pela concessionária.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vISSQN -->
	<xs:simpleType name="TSISSQNDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor do ISSQN (R$) = Valor da Base de Cálculo x Alíquota
					vISSQN = vBC x pAliq
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vRetCP -->
	<xs:simpleType name="TSRetCPDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do CP(R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vRetIRRF -->
	<xs:simpleType name="TSRetIRRFDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do IRRF (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vRetCSLL -->
	<xs:simpleType name="TSRetCSLLDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do CSLL (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>




	<!-- Para vBC (IBSCBS) -->
	<xs:simpleType name="TSBCIBSCBSDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor da base de cálculo (BC) do IBS/CBS antes das reduções para cálculo do tributo bruto.
					vBC = vServ - descIncond – vISSQN – vPIS - vCOFINS (2026)
					ou
					vBC = vServ - descIncond – vISSQN (2027 até 2032)
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vLiq -->
	<xs:simpleType name="TSLiqIBSCBSDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor líquido (R$) = Valor do serviço - Desconto condicionado - Desconto incondicionado - Valores retidos (CP, IRRF, CSLL)* - Valores, se retidos (ISSQN, PIS, COFINS)**
					VLiq = vServ – vDescIncond – vDescCond – (vRetCP + vRetIRRF + vRetCSLL)* – (vISSQN + vPIS + vCOFINS)**
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vTotNF -->
	<xs:simpleType name="TSTotNFIBSCBSDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor Total da NF considerando os impostos por fora IBS e CBS.
					O IBS e a CBS são por fora, por isso seus valores devem ser adicionados ao valor total da NF.
					vTotNF = VLiq + vCBS + vIBSTot
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vIBSTot -->
	<xs:simpleType name="TSIBSTotDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Total Valor do IBS Total.
					vIBSTot = vIBSUF + vIBSMun
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	

	

	<!-- Para pAliqEfetUF -->
	<xs:simpleType name="TSAliqEfetUFDesc2V2">
		<xs:restriction base="TSDec2V2">
			<xs:annotation>
				<xs:documentation>
					pAliqEfetUF = pIBSUF x (1 - pRedAliqUF)
					Se pRedAliqUF não for informado na DPS, então pAliqEfetUF é a própria pIBSUF.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vIBSUF -->
	<xs:simpleType name="TSValorIBSUFDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Total valor do IBS estadual.
					vIBSUF = vBC x (pIBSUF ou pAliqEfetUF) - (vCredPresIBS + vDifUF + vDevTribUF)
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>
	

	<!-- Para pAliqEfetMun -->
	<xs:simpleType name="TSAliqEfetMunDesc2V2">
		<xs:restriction base="TSDec2V2">
			<xs:annotation>
				<xs:documentation>
					pAliqEfetUF = pIBSUF x (1 - pRedAliqUF)
					Se pRedAliqUF não for informado na DPS, então pAliqEfetUF é a própria pIBSUF.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vIBSMun -->
	<xs:simpleType name="TSValorIBSMunDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Total valor do IBS municipal.
					vIBSMun = vBC x (pIBSMun ou pAliqEfetMun) - (vCredPresIBS + vDifMun + vDevTribMun)
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para pCBS -->
	<xs:simpleType name="TSPercCBSDesc2V2">
		<xs:restriction base="TSDec2V2">
			<xs:annotation>
				<xs:documentation>
					Alíquota da União para CBS cadastrada.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>
	

	<!-- Para vCBS -->
	<xs:simpleType name="TSValorCBSDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Total valor da CBS da União.
					vCBS = vBC x (pCBS ou pAliqEfetCBS) - (vCredPresCBS + vDifCBS + vDevTribCBS)
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para CNPJ -->
	<xs:simpleType name="TSCNPJFornec">
		<xs:restriction base="TSCNPJ">
			<xs:annotation>
				<xs:documentation>
					Número da inscrição federal (CNPJ) do fornecedor(prestador) do serviço: concessionária
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSNomeFornecDesc150">
		<xs:restriction base="TSDesc150">
			<xs:annotation>
				<xs:documentation>
					Nome / Nome Empresarial do fornecedor.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>



	<xs:simpleType name="TSMunFornec">
		<xs:restriction base="TSCodMunIBGE">
			<xs:annotation>
				<xs:documentation>
					Código do município do endereço do fornecedor do serviço.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para cLocOper -->
	<xs:simpleType name="TSLocOperCodMunIBGE">
		<xs:restriction base="TSCodMunIBGE">
			<xs:annotation>
				<xs:documentation>
					Código da localidade da operação (prestação) do serviço.
					Obs: Para a exploração de via, o local da operação (prestação) é o trecho de concessão de exploração de via para a qual a NFS-e Via foi emitida. Também é o local de incidência. O local da operação, para o IBS e para a CBS, será o mesmo local de incidência para o ISSQN.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>


	<!-- Para xLocOper -->
	<xs:simpleType name="TSLocOperDesc150">
		<xs:restriction base="TSDesc150">
			<xs:annotation>
				<xs:documentation>
					Descrição do código de 7 dígitos referente ao local da Operação(prestação) do serviço: nome dado ao trecho no cadastro pela concessionária.
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vDescIncond -->
	<xs:simpleType name="TSDescIncondDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do desconto incondicionado (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vDescIncond -->
	<xs:simpleType name="TSDescCondDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do desconto condicionado (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>


	<!-- Para vBCPisCofins -->
	<xs:simpleType name="TSBCPisCofinsDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor da Base de Cálculo do PIS/COFINS (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para pAliqPis -->
	<xs:simpleType name="TSAliqPisDesc2V2">
		<xs:restriction base="TSDec2V2">
			<xs:annotation>
				<xs:documentation>
					Valor da Alíquota do PIS (%).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para pAliqCofins -->
	<xs:simpleType name="TSAliqCofinsDesc2V2">
		<xs:restriction base="TSDec2V2">
			<xs:annotation>
				<xs:documentation>
					Valor da Alíquota da COFINS (%).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>

	<!-- Para vPis -->
	<xs:simpleType name="TSPisDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do PIS (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>


	<!-- Para vCofins -->
	<xs:simpleType name="TSCofinsDesc15V2">
		<xs:restriction base="TSDec15V2">
			<xs:annotation>
				<xs:documentation>
					Valor monetário do COFINS (R$).
				</xs:documentation>
			</xs:annotation>
		</xs:restriction>
	</xs:simpleType>	


	<xs:simpleType name="TSChaveNFSeVia">
		<xs:annotation>
			<xs:documentation>
				Chave de acesso da NFSeV. A regra de formação é:
				Cód.da localidade/trecho (7) + Amb.Ger. (1) + Inscrição Federal (14) + nNFS-e Via (13) + serie (3) + AnoMes Emis. da NFS-e Via (4) + Cód.Num. (7) + DV (1)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:maxLength value="50"/>
			<xs:pattern value="[0-9]{8}[0-9A-Z]{12}[0-9]{15}[0-9A-Z]{3}[0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSNum3Dig">
		<xs:annotation>
			<xs:documentation>Número com 3 dígitos</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:maxLength value="3"/>
			<xs:pattern value="[0-9]{1}[0-9]{0,2}"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="TSIdEvento">
		<xs:annotation>
			<xs:documentation>
				Identificador do evento: "EVT" + Chave de acesso(50) + Tipo do evento (6) + Numero Sequencial Evento(3) (nSeqEvento)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:maxLength value="62"/>
			<xs:pattern value="EVT[0-9]{8}[0-9A-Z]{12}[0-9]{15}[0-9A-Z]{3}[0-9]{21}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSCodJustCanc">
		<xs:annotation>
			<xs:documentation>
				Código de justificativa de cancelamento:				
				2 - Serviço não Prestado;				
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>			
			<xs:enumeration value="2"/>			
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSCodJustSubst">
		<xs:annotation>
			<xs:documentation>
				Código de justificativa para substituição de NFS-e Via:
				1 - Erro na Emissão;				
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:enumeration value="1"/>		
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSMotivo">
		<xs:annotation>
			<xs:documentation>Descrição do motivo da substituição da NFS-e</xs:documentation>
		</xs:annotation>
		<xs:restriction base="TSString">
			<xs:minLength value="15"/>
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="TSNumProtocolo">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:length value="39"/>
			<xs:pattern value="[0-9]{31}[0-9A-Z]{8}"/>
		</xs:restriction>
	</xs:simpleType>



</xs:schema>
